# Copy to sdkconfig.local before the first build. This file contains no secrets.
# Optional fallback; leave empty to configure Wi-Fi on the touchscreen.
CONFIG_TRANSLATOR_CUSTOMER_ID="YOUR_CUSTOMER_ID"
CONFIG_TRANSLATOR_CUSTOMER_SECRET="YOUR_CUSTOMER_SECRET"
CONFIG_TRANSLATOR_APP_ID="YOUR_APP_ID"
# Leave empty when App Certificate is disabled. Certificate-enabled RTC is not yet supported.
CONFIG_TRANSLATOR_APP_CERT=""

